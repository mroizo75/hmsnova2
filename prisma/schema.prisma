  projectId                    String                 @unique
  status                       ConstructionPlanStatus @default(DRAFT)
  organizationChart            String?                @db.Text // JSON-struktur for roller/entrepriser
  progressPlan                 String?                @db.Text // JSON-struktur for fremdrift
  specificMeasures             String?                @db.Text // JSON-liste av § 8 c-tiltak
  changeProcedure              String?                @db.Text // Rutine for endringer i SHA-plan
  builderName                  String?
  builderRepresentativeName    String?
  builderRepresentativeContact String?
  coordinatorPlanningName      String? // KP
  coordinatorExecutionName     String? // KU
  conflictAssessmentDocumented Boolean                @default(false)
  availableOnSite              Boolean                @default(false)
  lastReviewedAt               DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model ConstructionPreNotification {
  id                         String                         @id @default(cuid())
  tenantId                   String
  projectId                  String                         @unique
  status                     ConstructionNotificationStatus @default(DRAFT)
  sentAt                     DateTime?
  submissionDate             DateTime?
  projectAddress             String
  projectType                String
  builderName                String
  builderOrgNumber           String?
  builderAddress             String?
  builderPhone               String?
  builderRepresentativeName  String?
  builderRepresentativePhone String?
  coordinators               String?                        @db.Text // JSON med koordinatoropplysninger
  designers                  String?                        @db.Text // JSON med prosjekterende virksomheter
  contractors                String?                        @db.Text // JSON med utførende virksomheter
  expectedStartDate          DateTime
  expectedEndDate            DateTime?
