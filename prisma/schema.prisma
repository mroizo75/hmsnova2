// ============================================
// Timeregistrering (prosjekter, timer, kjøring)
// ============================================

model Project {
  id               String        @id @default(cuid())
  tenantId         String
  name             String
  code             String? // Prosjektkode (f.eks. "PRJ-001")
  orderNumber      String? // Ordrenr / oppdragsnr fra kunde
  clientName       String? // Kunde / oppdragsgiver
  location         String? // Arbeidssted / anleggsadresse
  description      String?       @db.Text
  status           ProjectStatus @default(PLANNING)
  startDate        DateTime?
  endDate          DateTime?
  projectManagerId String? // UserId for prosjektleder
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant                      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy                   User                           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  projectManager              User?                          @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  timeEntries                 TimeEntry[]
  mileageEntries              MileageEntry[]
  incidents                   Incident[]
  sjaAnalyses                 SjaAnalysis[]
  inspections                 Inspection[]
  measures                    Measure[]                      @relation("ProjectMeasures")
  constructionShaPlan         ConstructionShaPlan?
  constructionPreNotification ConstructionPreNotification?
  constructionRosterEntries   ConstructionRosterEntry[]
  constructionRosterChecks    ConstructionRosterDailyCheck[]
  riskAssessments             RiskAssessment[]
  formSubmissions             FormSubmission[]
  hmsTavle                    HmsTavle?

  @@index([tenantId])
  @@index([status])
  @@index([createdById])
  @@index([projectManagerId])
}

model ConstructionShaPlan {
  id                           String                 @id @default(cuid())
