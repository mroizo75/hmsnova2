  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  editedBy User?   @relation("MileageEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([projectId])
  @@index([userId])
  @@index([date])
}

// ============================================
// Navigation Menu Configuration
// ============================================

model NavigationItem {
  id           String   @id @default(cuid())
  tenantId     String? // Null = global default, String = tenant-specific
  key          String // Unique identifier (e.g. "dashboard", "documents")
  label        String // Display label or i18n key (e.g. "nav.dashboard")
  icon         String? // Icon name (e.g. "LayoutDashboard")
  href         String // Navigation path (e.g. "/dashboard")
  permission   String // Permission key to check (e.g. "dashboard")
  isSimpleMode Boolean  @default(false) // Show in simple mode
  isActive     Boolean  @default(true) // Is this menu item active
  order        Int      @default(0) // Sort order
  parentKey    String? // For nested menus (null = top level)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([isActive])
  @@index([order])
}

/// Brukerens tilpassede dashboard-oppsett per tenant
model DashboardConfig {
  id            String   @id @default(cuid())
  userId        String
  tenantId      String
  widgets       Json // Array av { id: string, order: number }
  hmsPulseItems Json? // Array av HmsPulseItem for tilsynsvisning
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// ============================================
// Brannøvelse (Forskrift om brannforebygging § 12 og § 13)
// ============================================

model FireDrill {
  id       String @id @default(cuid())
  tenantId String

  // Planleggingsfase — § 12b/c/d: rutiner for evakuering, kunnskap og informasjon
  title          String
  drillType      FireDrillType   @default(EVACUATION)
  isAnnounced    Boolean         @default(true)
  status         FireDrillStatus @default(PLANNED)
  plannedDate    DateTime
  location       String
  responsibleId  String // Øvingsleder
  objectives     String          @db.Text // Mål for øvelsen
  scenario       String?         @db.Text // Scenario-beskrivelse
  riskAssessment String?         @db.Text // Risikovurdering
  participantIds String?         @db.Text // JSON array av planlagte deltakere (userId[])

  // Delte lokaler — § 4 tredje ledd: eier skal sikre samordning mellom brukere
  sharedPremises           Boolean  @default(false) // Deler virksomheten lokaler med andre?
  buildingOwnerCoordinated Boolean? // Er byggeier/gårdeier koordinert og informert?
  buildingOwnerName        String? // Navn/kontakt for byggeier eller samordningsansvarlig
  otherTenantsInformed     Boolean? // Er øvrige leietakere/virksomheter informert?
  fullBuildingEvacuation   Boolean? // Var øvelsen felles for hele bygget (ikke bare egne lokaler)?
  totalBuildingOccupants   Int? // Totalt antall personer i bygget under øvelsen — § 13

  // Gjennomføringsfase — § 13: dokumentasjonskrav
  completedAt            DateTime?
  actualParticipantCount Int? // Antall faktiske deltakere (egne ansatte/tilhørende)
  evacuationTimeSeconds  Int? // Evakueringstid i sekunder
  observations           String?   @db.Text // Observasjoner under øvelsen

  // Evalueringsfase — § 12e + § 13: avdekke og rette opp mangler
  objectivesAchieved     String? // FULL | PARTIAL | NOT_ACHIEVED
  evaluation             String?   @db.Text // Evaluering og vurdering
  improvementPoints      String?   @db.Text // Forbedringspunkter
  procedureChangesNeeded Boolean?
  procedureChangesDesc   String?   @db.Text
  evaluatedBy            String? // userId for øvingsleder som bekreftet
  evaluatedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routineId String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routine  Routine?  @relation("FireDrillRoutine", fields: [routineId], references: [id], onDelete: SetNull)
  measures Measure[]

  @@index([tenantId])
  @@index([status])
  @@index([plannedDate])
  @@index([drillType])
  @@index([responsibleId])
}

// § 12b: type øvelse som gjennomføres
enum FireDrillType {
  EVACUATION // Evakueringsøvelse
  FIRE_SUPPRESSION // Slokkeopplæring
  ALARM_TEST // Brannalarmtest
  FULL_SCALE // Fullskalaøvelse
}

// Livssyklusstatus for en brannøvelse
enum FireDrillStatus {
  PLANNED // Planlagt
  IN_PROGRESS // Pågår
  COMPLETED // Gjennomført (mangler evaluering)
  EVALUATED // Evaluert og dokumentert — § 13 oppfylt
  CANCELLED // Avlyst
}

// ─────────────────────────────────────────────────────────────────
// DIGITAL HMS TAVLE – Bygg og anlegg
// Tre scenarior: Standalone (A), HMS Nova add-on (B), Hybrid (C)
// ─────────────────────────────────────────────────────────────────

/// Abonnement for Digital HMS Tavle (gjelder begge scenarior A og B)
model HmsTavleSubscription {
  id            String                     @id @default(cuid())
  tenantId      String                     @unique
  plan          HmsTavlePlan               @default(STANDARD)
  status        HmsTavleSubscriptionStatus @default(ACTIVE)
  isAddon       Boolean                    @default(false) // true = tillegg til HMS Nova (Scenario B)
  pricePerMonth Float
  startsAt      DateTime
  endsAt        DateTime // Prosjektvarighet / utløpsdato
  autoRenew     Boolean                    @default(false)
  maxTavler     Int                        @default(1) // Max antall aktive tavler
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([endsAt])
}

/// Plan-nivåer for HMS Tavle – styrer hvilke seksjoner og funksjoner som er tilgjengelige
enum HmsTavlePlan {
  ENKEL // kr 390/mnd – kontaktinfo, dokumentlenker, SHA-lenke
  STANDARD // kr 590/mnd – UE-portal, QR-innsjekk, alle seksjoner
  AVANSERT // kr 790/mnd – kiosk-modus, AI-innsikt, lovkrav-sjekkliste
  ADDON // kr 290/mnd – tillegg for eksisterende HMS Nova-kunder
}

/// Status for tavle-abonnement
enum HmsTavleSubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRING_SOON // < 14 dager igjen – cron setter denne
  EXPIRED
  CANCELLED
}

/// Digital HMS-tavle for ett prosjekt/byggeplass – Byggherreforskriften § 7, § 15
model HmsTavle {
  id          String  @id @default(cuid())
  tenantId    String
  projectId   String? @unique // Koblet til HMS Nova-prosjekt (Scenario B)
  name        String
  description String? @db.Text
  publicToken String  @unique @default(cuid()) // Token for QR-kode-tilgang

  isPublic  Boolean @default(false) // Offentlig tilgjengelig via QR
  kioskMode Boolean @default(false) // Fullskjerm kiosk-modus

  // Bransje – tilpasser seksjonstekster og lovkrav-referanser
  bransje String? @default("BYGG_ANLEGG") // Se BRANSJE_OPTIONS i koden

  // Opplysninger til oversiktslisten – Byggherreforskriften § 15 bokstav a og b
  siteAddress String? // Bygge- eller anleggsplassens adresse
  clientName  String? // Byggherrens navn

  /// Dato arbeidet ble avsluttet. Styrer sletting av oversiktslisten, som skal
  /// oppbevares i seks måneder etter avsluttet arbeid – Byggherreforskriften § 15.
  workEndedAt DateTime?

  // Branding
  logoUrl    String?
  brandColor String? // Hex-farge for aksentfarge

  // Manuell data for standalone-kunder (Scenario A)
  // I Scenario B hentes disse live fra HMS Nova-modeller
  manualContacts  Json? // [{name, role, phone, email}] – verneombud, nødetater etc.
  manualDocuments Json? // [{title, url, type}] – SHA-plan, beredskapsplan etc.

  sections            HmsTavleSection[]
  externalLinks       HmsTavleExternalLink[]
  subcontractorPortal SubcontractorPortal?
  checkins            TavleCheckin[]
  guestSubmissions    TavleGuestSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([publicToken])
}

/// Seksjon på en HMS-tavle – modulær og konfigurerbar
model HmsTavleSection {
  id          String              @id @default(cuid())
  tavleId     String
  type        HmsTavleSectionType
  title       String? // Overstyrer standard tittel
  order       Int
  isVisible   Boolean             @default(true)
  displayMode TavleDisplayMode    @default(KARUSELL)
  config      Json // Type-spesifikk konfig (f.eks. hvilke kontakter som vises)

  tavle HmsTavle @relation(fields: [tavleId], references: [id], onDelete: Cascade)

  @@index([tavleId])
}

/// Seksjontyper for HMS-tavlen
enum HmsTavleSectionType {
  SHA_PLAN // Byggherreforskriften § 7+8
  MANNSKAPSLISTE // Byggherreforskriften § 15
  AVVIK_STATISTIKK // AML § 5-1/5-2, IK-HMS § 5
  RUH_LISTE // Rapport om uønsket hendelse
  SJA_AKTIVE // Aktive sikker jobb-analyser
  VERNERUNDE_STATUS // Status siste vernerunde
  KONTAKTINFO // AML § 6-2 – verneombud synlig
  BEREDSKAPSPLAN // AML § 5-2 – beredskap tilgjengelig
  DOKUMENT_HUB // Samling av relevante dokumenter
  EKSTERN_LENKE // Lenker til Excel/SharePoint/andre systemer
  VAERMELDING // Yr-basert værvarsling for utendørsarbeid
  KPI_DASHBOARD // H-verdi, fraværsprosent, åpne tiltak
  HMS_PLAN_AARSHJUL // Årshjul for HMS-plan (kun HMS Nova add-on)
  FREMDRIFTSPLAN // Prosjektets fremdriftsplan
  RIGGPLAN // Riggplan / situasjonskart for byggeplassen
  RISIKOMATRISE // Risikooversikt (kun HMS Nova add-on)
  OPPLARING_STATUS // Kompetansestatus (kun HMS Nova add-on)
  LOVKRAV_SJEKKLISTE // Sanntids-indikator: alle lovkrav oppfylt?
  NYHETER_MELDINGER // Meldinger/nyheter fra prosjektledelsen
  SNARVEIER // Konfigurerbare hurtigtilganger til HMS-funksjoner
  GJEST_SKJEMA // Gjesteskjema – IK-HMS § 5 nr. 7, IK-mat § 5 nr. 4
  GJESTESERVICE_STATUS // Anonymisert tillitspanel – kun aggregerte tall, aldri saksinnhold
}

/// Visningsmode for seksjon på HMS-tavle
enum TavleDisplayMode {
  SIDEBAR // Fast i venstre kolonne (nødetater, kontakter)
  FAST // Alltid synlig i hoveddelen – roteres aldri bort
  KARUSELL // Roterer i kiosk-modus
  FOKUS // Fremhevet – tar full bredde øverst
}

/// Ekstern systemlenke på tavlen (Excel, SharePoint, andre HMS-systemer)
model HmsTavleExternalLink {
  id      String           @id @default(cuid())
  tavleId String
  title   String
  url     String
  type    ExternalLinkType
  icon    String? // Lucide-ikonnavn eller URL til bilde
  order   Int              @default(0)

  tavle HmsTavle @relation(fields: [tavleId], references: [id], onDelete: Cascade)

  @@index([tavleId])
}

/// Type ekstern lenke
enum ExternalLinkType {
  EXCEL
  PDF
  HMS_SYSTEM // Synergi, EHS Manager, m.fl.
  SHAREPOINT
  ANNET
}

/// Underentreprenør-portal tilknyttet en tavle
/// Byggherreforskriften § 18 – UE skal integrere SHA-plan i eget HMS-arbeid
model SubcontractorPortal {
  id             String  @id @default(cuid())
  tavleId        String  @unique
  portalToken    String  @unique @default(cuid()) // Eget token for UE-portal
  allowAvvik     Boolean @default(true)
  allowRuh       Boolean @default(true)
  allowSja       Boolean @default(true)
  allowPdfUpload Boolean @default(true)
  requireEmail   Boolean @default(true)
  autoApprove    Boolean @default(false) // true = innsendinger godkjennes direkte

  submissions SubcontractorSubmission[]

  tavle HmsTavle @relation(fields: [tavleId], references: [id], onDelete: Cascade)

  @@index([portalToken])
}

/// Innsending fra underentreprenør via portalen
model SubcontractorSubmission {
  id             String                        @id @default(cuid())
  portalId       String
  tenantId       String
  type           SubcontractorSubmissionType
  status         SubcontractorSubmissionStatus @default(PENDING)
  submitterName  String
  submitterEmail String?
  company        String?
  orgNr          String?
  data           Json // Type-spesifikk innsendingsdata
  attachmentUrls Json                          @default("[]") // Opplastede filer (R2-URL-er)

  // Kobling til HMS Nova-objekter etter gjennomgang (Scenario B)
  linkedIncidentId String?
  linkedRuhId      String?
  linkedSjaId      String?

  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portal SubcontractorPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@index([portalId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

/// Type innsending fra underentreprenør
enum SubcontractorSubmissionType {
  AVVIK
  RUH
  SJA
  NESTENULYKKE
  PDF_RAPPORT // Rapport fra UEs eget HMS-system
}

/// Status for UE-innsending
enum SubcontractorSubmissionStatus {
  PENDING // Venter på gjennomgang
  UNDER_REVIEW // Under behandling
  LINKED // Koblet til HMS Nova-objekt
  REJECTED // Avvist
}

// ─── Medarbeidersamtale ─────────────────────────────────────────────────────
// Hjemmel: AML § 4-2 (tilrettelegging, medvirkning og utvikling)
//          AML § 4-3 (psykososialt arbeidsmiljø, presisert 1. jan 2026)
//          Internkontrollforskriften § 5 (systematisk HMS-arbeid)
//          GDPR art. 5 og 9 (personvern, konfidensialitet)

/// Status for en medarbeidersamtale
enum EmployeeReviewStatus {
  PLANLAGT // Samtalen er planlagt men ikke gjennomført
  FORBEREDT // Ansatt har levert forberedelse
  GJENNOMFORT // Samtalen er gjennomført, referat fylt ut
  SIGNERT // Begge parter har signert/godkjent
  AVBRUTT // Samtalen er avbrutt
}

/// Status for et mål knyttet til medarbeidersamtalen
enum EmployeeReviewGoalStatus {
  IKKE_STARTET
  PAGAENDE
  OPPNADD
  IKKE_OPPNADD
}

/// Kategori for mål i medarbeidersamtalen
enum EmployeeReviewGoalCategory {
  FAGLIG // Faglig utvikling og kompetanse
  PERSONLIG // Personlig utvikling
  VIRKSOMHET // Bidrag til virksomhetens mål
}

/// Vurderingsnivå for psykososiale faktorer (AML § 4-3, 2026)
enum PsykososialtNiva {
  FORSVARLIG // Tilstanden er fullt forsvarlig
  DELVIS_FORSVARLIG // Tilstanden krever oppfølging
  IKKE_FORSVARLIG // Tilstanden er ikke forsvarlig – tiltak kreves
}

/// Medarbeidersamtale mellom leder og ansatt
/// AML § 4-2 (2): arbeidsgiver skal legge til rette for faglig og personlig utvikling
/// AML § 4-3 (2026): systematisk kartlegging av psykososiale arbeidsmiljøfaktorer
model EmployeeReview {
  id         String @id @default(cuid())
  tenantId   String
  employeeId String // Ansatt som samtalen gjelder
  reviewerId String // Leder/HR som gjennomfører samtalen

  scheduledDate  DateTime // Planlagt dato for samtalen
  completedDate  DateTime? // Faktisk gjennomføringsdato
  nextReviewDate DateTime? // Planlagt dato for neste samtale

  status EmployeeReviewStatus @default(PLANLAGT)

  // --- Ansattens forberedelse (fylles ut før samtalen) ---
  // Ansatt skal forberedes og ha mulighet til medvirkning (AML § 4-2 (2))
  ansattForberedelse String? @db.Text // Hva vil ansatt ta opp?
  ansattMedvirkning  String? @db.Text // Ansatts innspill til arbeidssituasjonen

  // --- Trivsel og arbeidssituasjon (AML § 4-2) ---
  trivselScore       Int? // 1-5: Generell trivsel på arbeidsplassen
  arbeidsmiljoeScore Int? // 1-5: Vurdering av arbeidsmiljø
  samarbeidScore     Int? // 1-5: Samarbeid med kolleger og leder

  // --- Psykososialt arbeidsmiljø (AML § 4-3, presisert 1. jan 2026) ---
  // § 4-3(2)a: uklare eller motstridende krav og forventninger i arbeidet
  psykKravOgForventninger PsykososialtNiva?
  // § 4-3(2)b: emosjonelle krav og belastninger i arbeid med mennesker
  psykEmosjonelleKrav     PsykososialtNiva?
  // § 4-3(2)c: arbeidsmengde og tidspress – ubalanse mellom krav og tid
  psykArbeidsmengde       PsykososialtNiva?
  // § 4-3(2)d: støtte og hjelp i arbeidet
  psykStotteOgHjelp       PsykososialtNiva?
  // Fritekstkommentar til psykososiale faktorer
  psykKommentar           String?           @db.Text

  // --- Mål og resultater ---
  maloppnaelseKommentar String? @db.Text // Gjennomgang av forrige periodes mål

  // --- Kompetanse og utvikling (AML § 4-2 (2)) ---
  kompetanseKommentar String? @db.Text // Nåværende kompetanse og utvikling
  opplaeringsOnske    String? @db.Text // Ønsker om kurs/opplæring
  karrierePlaner      String? @db.Text // Karriereplaner og ambisjoner

  // --- Tilrettelegging (AML § 4-2 (1)) ---
  tilretteleggingBehov String? @db.Text // Behov for tilrettelegging
  arbeidstidKommentar  String? @db.Text // Kommentarer til arbeidstid/balanse

  // --- Gjensidig tilbakemelding ---
  lederTilbakemeldingTilAnsatt String? @db.Text
  ansattTilbakemeldingTilLeder String? @db.Text

  // --- Oppsummering ---
  oppsummeringKommentar String? @db.Text

  // --- Signering (GDPR: ikke digital signatur, kun bekreftelse) ---
  signertAvAnsatt Boolean   @default(false)
  signertAvLeder  Boolean   @default(false)
  ansattSignertAt DateTime?
  lederSignertAt  DateTime?

  // GDPR art. 5: konfidensialitet – kun leder og ansatt ser samtalen som standard
  konfidensielt Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee User   @relation("EmployeeReviews", fields: [employeeId], references: [id])
  reviewer User   @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  goals   EmployeeReviewGoal[]
  actions EmployeeReviewAction[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([reviewerId])
  @@index([status])
  @@index([scheduledDate])
}

/// Mål satt i eller fulgt opp via medarbeidersamtalen
/// AML § 4-2 (2): faglig og personlig utvikling skal legges til rette for
model EmployeeReviewGoal {
  id       String @id @default(cuid())
  reviewId String
  tenantId String

  description String                     @db.Text
  category    EmployeeReviewGoalCategory @default(FAGLIG)
  status      EmployeeReviewGoalStatus   @default(IKKE_STARTET)
  deadline    DateTime?
  note        String?                    @db.Text

  // Kan overføres til neste samtale dersom ikke nådd
  overfortTilNeste Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review EmployeeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([tenantId])
}

/// Konkrete tiltak avtalt i medarbeidersamtalen
/// IK-HMS § 5: tiltak skal dokumenteres og følges opp
model EmployeeReviewAction {
  id       String @id @default(cuid())
  reviewId String
  tenantId String

  description String    @db.Text
  ansvarlig   String? // "LEDER" | "ANSATT" | "BEGGE"
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  note        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review EmployeeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([tenantId])
}

/// Innsjekk av mannskap via QR-kode på tavlen
/// Støtter Byggherreforskriften § 15 – elektronisk oversiktsliste
model TavleCheckin {
  id            String    @id @default(cuid())
  tavleId       String
  name          String // § 15 bokstav e
  employer      String? // Arbeidsgiver/innleievirksomhet – § 15 bokstav c
  employerOrgNr String? // Organisasjonsnummer – § 15 bokstav d
  hmsCardNr     String? // HMS-kortnummer – § 15 bokstav e
  birthDate     String? // Fødselsdato (YYYY-MM-DD) – § 15 bokstav e
  phone         String?
  checkedInAt   DateTime  @default(now())
  checkedOutAt  DateTime?
  date          String // YYYY-MM-DD – for daglig filtrering

  tavle HmsTavle @relation(fields: [tavleId], references: [id], onDelete: Cascade)

  @@index([tavleId])
  @@index([date])
  // Historikkvisning, CSV-eksport og oppbevaringsjobben for § 15
  @@index([tavleId, checkedInAt])
}

/// Gjestemelding sendt direkte fra HMS-tavlens offentlige visning
/// Hjemmel: IK-HMS § 5 nr. 7 (avvik), IK-mat § 5 nr. 4 (mattrygghet), intern KPI (klager)
model TavleGuestSubmission {
  id          String              @id @default(cuid())
  tavleId     String
  type        GuestSubmissionType
  message     String              @db.Text
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  roomOrTable String? // Romnummer, bordnummer e.l. – tilpasset bransje
  status      String              @default("NY") // NY | LEST | BEHANDLET | LUKKET
  response    String?             @db.Text
  respondedAt DateTime?

  // Privat statussporing – gjesten følger saken uten innlogging
  trackingToken String @unique @default(cuid())

  // Gjestens språk – styrer e-post og statusside
  locale String @default("nb") // nb | en

  // Prioritet settes automatisk ut fra meldingstype
  priority String @default("NORMAL") // NORMAL | HOY | KRITISK

  // Vedlegg lastet opp av gjest – [{key, name, size}] (MySQL støtter ikke scalar list)
  attachments Json?

  // GDPR art. 6 – samtykke til å bli kontaktet om saken
  consentContact Boolean @default(false)

  // Interne notater vises ALDRI på offentlig statusside
  internalNotes String? @db.Text

  assignedToId String?

  // SLA – serviceløfte og eskalering
  acknowledgedAt DateTime?
  closedAt       DateTime?
  slaDueAt       DateTime?
  escalatedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tavle HmsTavle @relation(fields: [tavleId], references: [id], onDelete: Cascade)

  @@index([tavleId])
  @@index([status])
  @@index([createdAt])
  @@index([tavleId, status, createdAt])
}

/// Meldingstyper fra gjesteskjema på HMS-tavle
enum GuestSubmissionType {
  AVVIK // Farlig situasjon observert – IK-HMS § 5
  KLAGE // Misnøye med tjeneste eller forhold
  MATFORGIFTNING // Matforgiftning/allergirespons – IK-mat § 5 nr. 4
  SPORSMAAL // Generell henvendelse
  TILBAKEMELDING // Positiv/negativ tilbakemelding
}

// ─── Beredskap reiseliv ──────────────────────────────────────────────────────
// Hjemmel: AML § 4-2, Pakkereiseloven § 14, IK-HMS § 5

/// Gjestehendelse – skade, sykdom eller kritisk situasjon for gjest
/// Hjemmel: AML § 5-2, Produktkontrolloven § 5, Pakkereiseloven § 14
model GjesteHendelse {
  id                    String    @id @default(cuid())
  tenantId              String
  type                  String // SKADE_PA_GJEST | SAVNET_GJEST | MEDISINSK_NODSITUASJON | BRANN | ANNET
  description           String    @db.Text
  location              String? // Sted for hendelsen
  guestName             String? // Navn på gjest (dersom kjent)
  guestContact          String? // Kontaktinfo (e-post/telefon)
  injurySeverity        String? // INGEN | LETT | ALVORLIG | LIVSTRUENDE
  actionsTaken          String?   @db.Text
  notifiedPolice        Boolean   @default(false)
  notifiedAmbulance     Boolean   @default(false)
  notifiedParents       Boolean   @default(false) // Pårørende varslet
  reportedToMattilsynet Boolean   @default(false) // Kun ved matforgiftning
  status                String    @default("AAPEN") // AAPEN | UNDER_BEHANDLING | LUKKET
  closedAt              DateTime?
  closedBy              String?
  occurredAt            DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([occurredAt])
}

/// Hotell-evakueringsplan med etasje- og soneansvarlige
model HotellEvakueringsplan {
  id                String    @id @default(cuid())
  tenantId          String
  planName          String
  buildingName      String?
  totalFloors       Int       @default(1)
  maxOccupancy      Int?
  assemblyPoint     String? // Samlingspunkt
  fireWarden        String? // Brannvernansvarlig
  isActive          Boolean   @default(true)
  lastReviewedAt    DateTime?
  floors            Json      @default("[]") // [{floorNr, responsible, roomCount, notes}]
  emergencyContacts Json      @default("[]") // [{name, role, phone}]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Aktivitetssikkerhet ─────────────────────────────────────────────────────
// Hjemmel: Produktkontrolloven § 3, AML § 3-1, IK-HMS § 5

/// Daglig utstyrssjekk for aktivitetsbedrifter (kano, sykkel, klatrevegg, etc.)
/// Hjemmel: Produktkontrolloven § 3 – sikkerhet for forbrukerprodukter
model AktivitetsUtstyrssjekk {
  id           String    @id @default(cuid())
  tenantId     String
  utstyrsType  String // KANO | SYKKEL | SKI | KLATREVEGG | ZIPLINE | ANNET
  utstyrsNavn  String // Beskrivende navn (eks. "Kano nr. 12")
  checkDate    DateTime
  checkedBy    String?
  status       String    @default("OK") // OK | AVVIK | KASSERT
  findings     String?   @db.Text
  actionsTaken String?   @db.Text
  nextCheckAt  DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([checkDate])
}

// ─── Transportmodul ──────────────────────────────────────────────────────────
// Hjemmel: Yrkestransportlova § 4, Vegtransportloven § 7, Forskrift om yrkessjåfør

/// Transport-journal – kjøre-/hviletid og kjøretøykontroll
/// Hjemmel: Vegtransportloven § 7 (kjøre-/hviletid), Yrkestransportlova
model TransportJournal {
  id            String   @id @default(cuid())
  tenantId      String
  vehicleReg    String // Registreringsnummer
  driverName    String
  date          String // YYYY-MM-DD
  departureTime String // HH:MM
  arrivalTime   String? // HH:MM
  routeDesc     String? // Kort rutebeskrivelse
  kmStart       Float?
  kmEnd         Float?
  drivingHours  Float? // Timer kjøring
  breakHours    Float? // Timer pause
  preCheckDone  Boolean  @default(false) // Forhåndskontroll kjøretøy utført
  preCheckNote  String?  @db.Text
  incidents     String?  @db.Text
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
  @@index([vehicleReg])
}

// ─── Transport – sjåfør- og løyvedokumentasjon ───────────────────────────────
// Hjemmel: Yrkestransportlova § 4, Vegtransportloven kap. 3

/// Sjåførdokument – kompetansebevis, yrkessjåfør
/// Hjemmel: Yrkestransportlova § 4, EU forordning 2003/59
model SjaforDokument {
  id              String    @id @default(cuid())
  tenantId        String
  driverName      String
  driverPhone     String?
  kompetansebevis String? // Nummer på kompetansebevis
  kbUtlopDato     DateTime?
  forerkortNr     String?
  forerkortKlasse String? // C, D, CE, DE etc.
  forerkortUtlop  DateTime?
  adrSertifikat   String?
  adrUtlop        DateTime?
  notat           String?   @db.Text
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Løyvedokument – rutegående transport og turvogn
/// Hjemmel: Yrkestransportlova § 4 og § 6
model LoyveRegister {
  id          String    @id @default(cuid())
  tenantId    String
  loyveType   String // RUTELOEYVE, TURVOGN, GODS, TURBUSS
  loyveNummer String
  kjoretoyReg String?
  utstedtAv   String?
  utlopDato   DateTime?
  vilkar      String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── IK-mat / HACCP ─────────────────────────────────────────────────────────
// Hjemmel: IK-mat § 4 og § 5, forordning (EF) 852/2004 art. 5 (HACCP)

/// HACCP-plan – Hazard Analysis and Critical Control Points
/// Hjemmel: Forordning (EF) 852/2004 Art. 5, IK-mat-forskriften
model HaccpPlan {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String?   @db.Text
  isActive    Boolean   @default(true)
  version     Int       @default(1)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ccp    HaccpCcp[]

  @@index([tenantId])
}

/// CCP – Kritisk kontrollpunkt i HACCP-planen
model HaccpCcp {
  id             String @id @default(cuid())
  planId         String
  stepName       String // Prosesstrinn (mottak, lagring, tilberedning, servering)
  hazardDesc     String @db.Text // Fareanalyse
  hazardType     String // BIOLOGISK | KJEMISK | FYSISK
  criticalLimit  String // Kritisk grenseverdi (f.eks. 75°C kjernetemperatur)
  monitorMethod  String // Overvåkningsmetode
  monitorFreq    String // Frekvens (daglig, per parti, etc.)
  corrAction     String @db.Text // Korrigerende tiltak
  verifyMethod   String // Verifiseringsmetode
  recordRequired String // Hva skal dokumenteres
  order          Int    @default(0)

  plan HaccpPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

/// Temperaturlogg for kjøle-/fryseanlegg – HACCP CCP
/// Hjemmel: Forordning (EF) 852/2004 Art. 5 (HACCP)
model TemperaturLog {
  id            String   @id @default(cuid())
  tenantId      String
  unitName      String // Navn på kjøle-/fryseanlegg
  unitType      String // KJOLEROM | FRYSER | VARMHOLDING | ANNET
  measuredAt    DateTime
  temperature   Float // Grader Celsius
  measuredBy    String? // Navn/initialer
  isDeviation   Boolean  @default(false) // Om temperaturen er utenfor grenseverdiene
  deviationNote String?  @db.Text
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([measuredAt])
  @@index([unitName])
}

/// Allergenoversikt – de 14 EU-allergener
/// Hjemmel: EU-forordning 1169/2011, Matmerkeforskriften § 5
model AllergenOversikt {
  id             String    @id @default(cuid())
  tenantId       String
  dishName       String // Navn på rett/produkt
  category       String? // Kategori (Forrett, Hovedrett, Dessert, etc.)
  // Allergener som boolske flagg – de 14 EU-allergener
  hasGluten      Boolean   @default(false)
  hasKrepsdyr    Boolean   @default(false)
  hasEgg         Boolean   @default(false)
  hasFisk        Boolean   @default(false)
  hasPeanut      Boolean   @default(false)
  hasSoya        Boolean   @default(false)
  hasMelk        Boolean   @default(false)
  hasNotter      Boolean   @default(false)
  hasSelleri     Boolean   @default(false)
  hasSennep      Boolean   @default(false)
  hasSesamfro    Boolean   @default(false)
  hasSulfitt     Boolean   @default(false)
  hasLupin       Boolean   @default(false)
  hasBlotkdyr    Boolean   @default(false)
  additionalInfo String?   @db.Text // Merknader
  isActive       Boolean   @default(true)
  lastVerified   DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Mattilsynet-inspeksjon / Smilefjeskarakter
/// Hjemmel: Smilefjesforskriften FOR 2016-05-19-501
model MattilsynetInspeksjon {
  id               String    @id @default(cuid())
  tenantId         String
  inspectedAt      DateTime
  inspector        String?
  smilejesKarakter String? // STRAALENDE | GODT | NOYTRAL | TRIST (Mattilsynets kategorier)
  findings         String?   @db.Text // Funn og merknader
  followUpDeadline DateTime?
  followUpNote     String?   @db.Text
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inspectedAt])
}

// ─── BHT og nattarbeid ───────────────────────────────────────────────────────
// Hjemmel: AML § 3-3 (BHT-plikt), AML § 10-11 (nattarbeid)
// BHT kode 55.1 (hotell), 56.1 (restaurant) er obligatoriske bransjer

/// BHT-avtale – Bedriftshelsetjeneste
/// Hjemmel: AML § 3-3, Forskrift om organisering av arbeidsmiljøarbeid § 2-1
model BhtAvtale {
  id              String    @id @default(cuid())
  tenantId        String
  leverandorNavn  String
  leverandorOrgnr String?
  kontaktperson   String?
  kontaktTelefon  String?
  kontaktEpost    String?
  startDato       DateTime
  sluttDato       DateTime?
  arsTimeverk     Int? // Avtalte timer per år
  naringskode     String? // f.eks. 55.1, 56.1, 56.3
  bransjeKrav     String? // Beskrivelse av BHT-pliktig aktivitet
  avtaleUrl       String?
  isActive        Boolean   @default(true)
  notat           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Nattarbeidsvurdering per stilling/avdeling
/// Hjemmel: AML § 10-11 – nattarbeid tillatt kun ved særlige behov, arbeidsgivers vurderingsplikt
model NattarbeidVurdering {
  id             String    @id @default(cuid())
  tenantId       String
  stillingNavn   String // Stilling eller avdeling, f.eks. "Nattresepsjonist"
  begrunnelse    String    @db.Text // Lovpålagt begrunnelse for nattarbeid
  alternativVurd String?   @db.Text // Vurdering av alternativer til nattarbeid
  helseVurdering Boolean   @default(false) // Helsevurdering gjennomført?
  samRadVo       Boolean   @default(false) // Drøftet med verneombud?
  godkjentAv     String?
  godkjentDato   DateTime?
  gyldigTil      DateTime? // Vurderingen revideres periodisk
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Safety Intelligence Platform ────────────────────────────────────────────
// Anonymisert datamotor for bransjestatistikk, benchmarks og prediktiv risikoscoring.
// GDPR art. 6(1)(a) samtykke + art. 6(1)(f) berettiget interesse for aggregerte data.

/// Tenant-samtykke for deltakelse i anonymisert bransjestatistikk
/// Default: opted-in (alle er med med mindre de aktivt velger a sta utenfor)
model IntelligenceConsent {
  id         String    @id @default(cuid())
  tenantId   String    @unique
  optedIn    Boolean   @default(true)
  optedInAt  DateTime?
  optedOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Aggregert bransjesnapshot — k-anonymity (k >= 5 tenants) sikrer at enkeltbedrifter ikke kan identifiseres
model IndustrySnapshot {
  id                     String   @id @default(cuid())
  industry               String
  period                 String // "2027-Q2", "2027-06"
  periodType             String // QUARTERLY, MONTHLY, WEEKLY
  tenantCount            Int // Antall bidragende tenants
  employeeCount          Int // Aggregert antall ansatte

  incidentCount          Int
  incidentsByType        Json // { AVVIK: 12, NESTEN: 8, ULYKKE: 2, ... }
  incidentsBySeverity    Json // { "1": 5, "2": 8, ... }
  avgMttr                Float? // Mean Time To Resolve (dager)
  trir                   Float? // Total Recordable Incident Rate
  ltir                   Float? // Lost Time Incident Rate

  avgRiskScore           Float?
  risksByCategory        Json // { SAFETY: 45, HEALTH: 20, ... }
  risksOpenCount         Int

  measuresTotal          Int
  measuresCompleted      Int
  avgMeasureTime         Float? // Snitt dager til ferdig

  trainingComplianceRate Float? // % ansatte med gyldig opplaering
  expiredTrainingCount   Int

  inspectionCount        Int
  findingsAvgSeverity    Float?

  highRiskChemicalCount  Int

  createdAt              DateTime @default(now())

  @@unique([industry, period, periodType])
  @@index([industry])
  @@index([periodType, period])
}

/// Per-tenant score beregnet fra anonymisert sammenligning med bransje
model TenantIntelligenceScore {
  id                 String   @id @default(cuid())
  tenantId           String
  period             String // "2027-Q2"

  overallScore       Float // 0-100
  riskScore          Float // Prediktiv risiko (hoyere = mer risiko)
  complianceScore    Float // 0-100
  trendDirection     String // IMPROVING, STABLE, DECLINING

  incidentScore      Float
  trainingScore      Float
  measureScore       Float
  inspectionScore    Float

  industryPercentile Int? // 0-100 (posisjon i bransjen)

  factors            Json // Forklarende faktorer for scoren

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
  @@index([period])
}

/// Tidsserie for enkeltmetrikker, per bransje eller globalt
model TrendDataPoint {
  id            String   @id @default(cuid())
  industry      String? // null = alle bransjer samlet
  metric        String // "incidents_total", "trir", "training_compliance", etc.
  period        String // "2027-06"
  value         Float
  prevValue     Float?
  changePercent Float?

  createdAt     DateTime @default(now())

  @@unique([industry, metric, period])
  @@index([metric, period])
}

/// API-nokkel for eksterne kunder (forsikring, NHO, myndigheter)
model IntelligenceApiKey {
  id          String    @id @default(cuid())
  name        String // "Gjensidige Forsikring", "NHO"
  hashedKey   String    @unique
  permissions Json // { industries: ["all"], metrics: ["incidents", "trir"] }
  rateLimit   Int       @default(100) // requests per hour
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  logs IntelligenceApiLog[]
}

/// Brukslogg for API-nokler
model IntelligenceApiLog {
  id         String   @id @default(cuid())
  apiKeyId   String
  endpoint   String
  params     Json?
  responseMs Int
  createdAt  DateTime @default(now())

  apiKey IntelligenceApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
}

/// Levende HMS Håndbok – versjonskontrollert med bransje-maler, godkjenningsflyt og signering per versjon
/// IK-HMS § 5, AML kap. 3
model HmsHandbook {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  currentVersionId String? // ID til gjeldende godkjent versjon

  // Siste gjennomgang og godkjenning
  lastReviewedAt DateTime?
  reviewedById   String?
  reviewedBy     User?     @relation("HandbookReviewer", fields: [reviewedById], references: [id])

  // Relasjoner
  versions   HandbookVersion[]
  signatures HandbookSignature[]
  branding   HandbookBranding?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
}

/// Versjonskontroll for HMS Håndbok – hver versjon har egne seksjoner og signaturer
/// IK-HMS § 5 nr. 8: foreta systematisk overvåking og gjennomgang
model HandbookVersion {
  id         String @id @default(cuid())
  handbookId String
  handbook   HmsHandbook @relation(fields: [handbookId], references: [id], onDelete: Cascade)

  version     String // "1.0", "1.1", "2.0"
  status      HandbookVersionStatus @default(DRAFT)
  changeNote  String?   @db.Text

  approvedById String?
  approvedBy   User?    @relation("HandbookApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectedNote String?  @db.Text

  createdById  String?
  createdByUser User?   @relation("HandbookVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  basedOnTemplateId String?
  basedOnVersionId  String?

  sections   HandbookSection[]
  signatures HandbookSignature[]

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([handbookId, version])
  @@index([handbookId, status])
}

/// Hierarkisk seksjon i HMS Håndbok – støtter underseksjoner og rich text-innhold
model HandbookSection {
  id        String @id @default(cuid())
  versionId String
  version   HandbookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  parentId    String?
  parent      HandbookSection? @relation("SubSections", fields: [parentId], references: [id], onDelete: Cascade)
  children    HandbookSection[] @relation("SubSections")

  sectionKey    String // "s1", "s2", "s3.1", "s6-bransjespesifikk"
  sectionNumber String // "1", "1.1", "6.3"
  title         String // "HMS-styringssystem og omfang"
  content       String @db.LongText // Rich text HTML fra Tiptap
  legalRef      String? // "AML § 3-1, IK-HMS § 5"
  sortOrder     Int
  moduleLink    String? // Kobling til HMS Nova-modul: "/dashboard/risks"
  updatedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versionId, sectionKey])
  @@index([versionId, sortOrder])
  @@index([parentId])
}

/// Bransje-mal for HMS Håndbok – f.eks. "NHO Reiseliv Standard"
model HandbookTemplate {
  id          String @id @default(cuid())
  name        String // "NHO Reiseliv Standard", "Lager og logistikk Basis"
  description String? @db.Text
  industry    String // "hospitality", "construction", "all"

  sections    Json // [{ sectionKey, sectionNumber, title, content, legalRef, sortOrder, moduleLink, children }]
  variables   Json? // ["bedriftsnavn", "adresse", "dagligLeder", "hmsAnsvarlig", "verneombud"]

  isActive    Boolean @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([industry, isActive])
}

/// Branding-innstillinger for HMS Håndbok – logo, header, footer, farge
model HandbookBranding {
  id         String @id @default(cuid())
  handbookId String @unique
  handbook   HmsHandbook @relation(fields: [handbookId], references: [id], onDelete: Cascade)

  logoUrl      String? // Bedriftens logo
  headerText   String? // "HMS Håndbok 2026"
  footerText   String? // "Konfidensielt"
  primaryColor String? // Merkevarefarge for PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HandbookVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

/// Signatur på HMS Håndbok – dokumenterer at ansatt har lest og forstått håndboken
/// Signering kan knyttes til en spesifikk versjon (per-versjon signering)
model HandbookSignature {
  id         String      @id @default(cuid())
  handbookId String
  handbook   HmsHandbook @relation(fields: [handbookId], references: [id], onDelete: Cascade)
  versionId  String?
  version    HandbookVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  userId     String
  user       User        @relation("HandbookSignatures", fields: [userId], references: [id])
  signedAt   DateTime    @default(now())
  comment    String?

  @@index([handbookId])
  @@index([versionId])
  @@index([userId])
}

// ============================================
// HMS Intelligens-motor
// Lokal, event-drevet motor som oppdager mønstre,
// beregner HMS-score og genererer forbedringsforslag.
// IK-HMS § 5 nr. 6–8: kontinuerlig forbedring
// ============================================

/// Pre-beregnet mønster-cache – oppdagede trender på tvers av HMS-moduler
model PatternCache {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patternType PatternType
  patternKey  String      // Dedupliseringsnøkkel (f.eks. "RECURRING_INCIDENT:fallsikring:2026-Q3")
  matchCount  Int         // Antall hendelser som matcher
  firstSeen   DateTime    // Når mønsteret først ble oppdaget
  lastSeen    DateTime    // Siste match
  severity    Int         // 1-5 beregnet fra underliggende data

  linkedIncidentIds Json @default("[]") // JSON-array av avvik-IDer
  linkedFindingIds  Json @default("[]") // JSON-array av vernerundenfunn-IDer
  linkedRuhIds      Json @default("[]") // JSON-array av RUH-rapport-IDer

  isActive   Boolean   @default(true)
  resolvedAt DateTime? // Når mønsteret ble løst/lukket

  suggestions ImprovementSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, patternKey])
  @@index([tenantId, isActive])
}

/// Forbedringsforslag generert av intelligens-motoren basert på oppdagede mønstre
model ImprovementSuggestion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patternCacheId String
  pattern        PatternCache @relation(fields: [patternCacheId], references: [id], onDelete: Cascade)

  suggestionType    SuggestionTarget
  title             String // "Oppdater rutine for arbeid i høyde"
  description       String @db.Text // Detaljert beskrivelse med lovhenvisning
  legalBasis        String? // "IK-HMS § 5 nr. 7, AML § 3-1"
  targetRoutineId   String? // Hvilken rutine bør endres (valgfri)
  targetSectionKey  String? // Håndbokseksjon dette forslaget gjelder (f.eks. "s4" for avvik)
  priority          Int // 1-5 basert på alvorlighet + frekvens

  status     SuggestionStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  decisionNote String?  @db.Text
  implementedAt DateTime?

  logs ImprovementLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

/// Forbedringslogg – dokumenterer gjennomførte endringer for Arbeidstilsynet (IK-HMS § 5 nr. 7–8)
model ImprovementLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  changeType     ChangeType
  description    String     @db.Text
  legalReference String? // F.eks. "IK-HMS § 5 nr. 7"

  suggestionId String?
  suggestion   ImprovementSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)

  routineId   String? // Hvilken rutine ble endret
  incidentIds Json     @default("[]") // JSON-array av avvik-IDer som var årsak

  beforeSnapshot Json? // Tilstand før endring (for dokumentasjon)
  afterSnapshot  Json? // Tilstand etter endring
  changedById    String
  changedAt      DateTime @default(now())

  followUpDate   DateTime? // Når effekten skal vurderes
  effectReviewed Boolean   @default(false)
  effectNote     String?   @db.Text

  @@index([tenantId, changedAt])
  @@index([suggestionId])
}

/// Daglig HMS-score per bedrift – historikk for trendvisning og rapportering
model TenantHmsScore {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 7 delscorer (0-100), vektet etter IK-HMS § 5
  incidentScore   Int // Avvikshåndtering: frekvens, alvorlighet, lukkehastighet
  routineScore    Int // Rutiner: dekningsgrad, revisjonsstatus
  inspectionScore Int // Vernerunder: frekvens, funnoppfølging
  trainingScore   Int // Opplæring: compliance-rate, utgått opplæring
  riskScore       Int // Risikovurderinger: dekning, oppfølging av høye risikoer
  measureScore    Int // Tiltak: fullføringsrate, tid til lukking
  handbookScore   Int // Håndbok/dokumentasjon: gjennomgang, signaturer

  overallScore Int        // Vektet gjennomsnitt (0-100)
  trend        ScoreTrend
  scoreDate    DateTime   // Dag scoren gjelder for

  // Konteksttall for rask visning uten ekstra query
  openIncidents      Int
  overdueMeasures    Int
  expiredTraining    Int
  routinesNeedReview Int
  pendingSuggestions Int

  createdAt DateTime @default(now())

  @@unique([tenantId, scoreDate])
  @@index([tenantId, scoreDate])
}

/// Kuratert lovkunnskapsbase – norsk HMS-regelverk for referanse og forslag
model HmsKnowledgeEntry {
  id              String   @id @default(cuid())
  category        String // "AML", "IK_HMS", "FORSKRIFT", "VEILEDNING"
  lawReference    String   @unique // "AML_5_2", "IK_HMS_5_7"
  title           String
  content         String   @db.Text // Full lovtekst eller sammendrag
  summary         String // Kort oppsummering for bruk i forslag
  applicableAreas Json @default("[]") // ["avvik", "vernerunde", "opplæring"]
  industry        Json @default("[]") // ["alle", "bygg", "industri"]
  triggerPatterns Json @default("[]") // ["RECURRING_INCIDENT", "TRAINING_GAP"]
  lastVerified    DateTime // Sist sjekket mot lovdata.no
  sourceUrl       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Anonymisert statistikk per bedrift per periode – for forsikring og Arbeidstilsynet
model AnonymizedTenantStats {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime

  employeeCount       Int
  incidentsTotal      Int
  incidentsByType     Json // {"AVVIK": 5, "NESTEN": 2, ...}
  incidentsBySeverity Json // {"1": 3, "2": 2, "3": 1}
  avgClosureDays      Float?
  trir                Float? // Total Recordable Injury Rate
  ltir                Float? // Lost Time Injury Rate

  risksTotal    Int
  risksHighCount Int // Antall risikoer med score ≥ 15

  inspectionsTotal   Int
  findingsTotal      Int
  findingsClosed     Int
  avgFindingSeverity Float?

  trainingCompliance Float? // 0-100 %
  trainingsExpired   Int

  measuresTotal     Int
  measuresCompleted Int
  measuresOverdue   Int
  avgMeasureDays    Float? // Snitt dager til lukking

  chemicalsTotal    Int
  chemicalsHighRisk Int

  hmsScore Int? // Samlet HMS-score for perioden

  createdAt DateTime @default(now())

  @@unique([tenantId, periodStart])
  @@index([tenantId])
}

// HMS Intelligens-motor – enums

enum PatternType {
  RECURRING_INCIDENT // Gjentakende avvik i samme kategori/område
  INSPECTION_TREND // Vernerundenfunn som gjentar seg
  TRAINING_GAP // Hendelser der opplæring manglet / utløpte sertifikater
  RISK_ESCALATION // Risiko som har økt over tid / review passert
  MEASURE_INEFFECTIVE // Tiltak som ikke gir effekt (avvik gjenoppstår)
  COMPLIANCE_DRIFT // Rutiner som ikke følges (avvik vs. rutineinnhold)
  RUH_TREND // Gjentakende RUH-rapporter i samme kategori/lokasjon
  SJA_COVERAGE_GAP // Høyrisiko-aktiviteter uten tilhørende SJA
  CHEMICAL_COMPLIANCE // Kjemikalier med utdatert SDS eller manglende datablad
  FIRE_SAFETY_GAP // Brannøvelse ikke gjennomført siste 12 mnd
  MANAGEMENT_REVIEW_OVERDUE // Ledelsens gjennomgang ikke gjennomført i tide
}

enum SuggestionTarget {
  UPDATE_ROUTINE
  CREATE_ROUTINE
  UPDATE_HANDBOOK
  ADD_TRAINING
  ADD_RISK_ASSESSMENT
  UPDATE_SJA_TEMPLATE
  SCHEDULE_INSPECTION
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  IMPLEMENTED
}

enum ChangeType {
  ROUTINE_UPDATED
  ROUTINE_CREATED
  TRAINING_ADDED
  RISK_REASSESSED
  SJA_UPDATED
  INSPECTION_SCHEDULED
  HANDBOOK_REVIEWED
  MEASURE_ADDED
}

enum ScoreTrend {
  IMPROVING
  STABLE
  DECLINING
}

// ============================================
// Konsern / Kjede (Corporate Group)
// ============================================

model CorporateGroup {
  id           String  @id @default(cuid())
  name         String
  orgNumber    String?
  slug         String  @unique
  contactEmail String?
  contactPhone String?
  logo         String?
  settings     Json?

  tenants       CorporateGroupTenant[]
  users         CorporateGroupUser[]
  content       CorporateGroupContent[]
  distributions CorporateGroupDistribution[]
  auditLogs     CorporateGroupAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model CorporateGroupTenant {
  id       String                     @id @default(cuid())
  groupId  String
  tenantId String
  status   CorporateGroupTenantStatus @default(ACTIVE)
  joinedAt DateTime                   @default(now())

  group  CorporateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([groupId, tenantId])
  @@index([groupId])
  @@index([tenantId])
}

enum CorporateGroupTenantStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model CorporateGroupUser {
  id      String             @id @default(cuid())
  groupId String
  userId  String
  role    CorporateGroupRole

  group CorporateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

enum CorporateGroupRole {
  GROUP_ADMIN
  GROUP_HMS
  GROUP_READER
}

model CorporateGroupContent {
  id               String                       @id @default(cuid())
  groupId          String
  contentType      CorporateGroupContentType
  title            String
  description      String?                      @db.Text
  content          Json?
  fileKey          String?
  mime             String?
  distributionMode CorporateGroupDistMode       @default(CUSTOMIZABLE)
  status           CorporateGroupContentStatus  @default(DRAFT)
  version          String                       @default("1.0")
  legalReference   String?
  category         String?
  createdById      String
  updatedById      String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  group         CorporateGroup               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  distributions CorporateGroupDistribution[]

  @@index([groupId])
  @@index([contentType])
  @@index([status])
}

enum CorporateGroupContentType {
  ROUTINE
  DOCUMENT
  RISK_ASSESSMENT
  INSPECTION_TEMPLATE
  SJA_TEMPLATE
  TRAINING_COURSE
  CHEMICAL
  HANDBOOK_SECTION
}

enum CorporateGroupDistMode {
  LOCKED
  CUSTOMIZABLE
}

enum CorporateGroupContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CorporateGroupDistribution {
  id              String                          @id @default(cuid())
  contentId       String
  groupId         String
  tenantId        String
  status          CorporateGroupDistributionStatus @default(PENDING)
  localResourceId String?
  locallyModified Boolean                         @default(false)
  distributedAt   DateTime?
  distributedById String?

  content CorporateGroupContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  group   CorporateGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, tenantId])
  @@index([contentId])
  @@index([groupId])
  @@index([tenantId])
  @@index([status])
}

enum CorporateGroupDistributionStatus {
  PENDING
  DISTRIBUTED
  REJECTED
  WITHDRAWN
}

model CorporateGroupAuditLog {
  id         String @id @default(cuid())
  groupId    String
  userId     String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?

  group CorporateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Rutineversjonering (IK-HMS § 5 nr. 7-8)
// ============================================

model RoutineVersion {
  id            String   @id @default(cuid())
  routineId     String
  versionNumber Int
  changeNumber  String // Format: "ENR-2026-001"
  changeSummary String   @db.Text
  changeReason  String?  @db.Text
  content       Json
  legalReference String?
  changedById   String
  createdAt     DateTime @default(now())

  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@unique([routineId, versionNumber])
  @@index([routineId])
}

// ============================================
// Risiko-rutine kobling
// ============================================

model RiskRoutineLink {
  id        String   @id @default(cuid())
  riskId    String
  routineId String
  createdAt DateTime @default(now())

  risk    Risk    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([riskId, routineId])
}

// ============================================
// Mitt Regelverk: Virksomhetsprofil og regelverksmotor
// ============================================

model TenantActivityProfile {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  answers          Json // { "has_chemicals": true, "work_at_height": false, ... }
  activeActivities Json // ["chemicals", "height_work", ...] utledet fra svar + NACE
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RegulatoryRequirement {
  id                String   @id @default(cuid())
  title             String
  description       String   @db.Text
  legalBasis        String // Lov/forskrift-referanse
  sourceUrl         String? // Lenke til lovdata.no
  triggerActivities Json // ["chemicals"] - matcher activeActivities
  hmsNovaFeature    String? // "chemical_register", "risk_assessment", etc.
  hmsNovaRoute      String? // "/dashboard/stoffkartotek"
  routineCategory   String? // Kobling til rutine-kategori
  severity          String   @default("MANDATORY") // MANDATORY, RECOMMENDED, OPTIONAL
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  overrides TenantRequirementOverride[]
}

model TenantRegulatoryProfile {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  generatedAt  DateTime @default(now())
  requirements Json // [{ requirementId, status, checkedAt }]
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ============================================
// Serviceforespørsel (HMS-oppsett som tjeneste)
// ============================================

model ServiceRequest {
  id          String               @id @default(cuid())
  tenantId    String
  type        ServiceRequestType
  status      ServiceRequestStatus @default(PENDING)
  description String?              @db.Text
  price       Int? // Pris i øre
  notes       String?              @db.Text
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

// ============================================
// Manuell overstyring/bekreftelse av lovkrav
// ============================================

model TenantRequirementOverride {
  id                      String    @id @default(cuid())
  tenantId                String
  regulatoryRequirementId String?
  customTitle             String?
  customDescription       String?   @db.Text
  customLegalBasis        String?
  manualStatus            String // COMPLIANT, PARTIAL, NOT_APPLICABLE
  statusNote              String?   @db.Text
  verifiedAt              DateTime?
  verifiedById            String?
  documentUrl             String?
  documentName            String?
  isCustomRequirement     Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verifiedBy  User?                   @relation("RequirementOverrideVerifier", fields: [verifiedById], references: [id])
  requirement RegulatoryRequirement?  @relation(fields: [regulatoryRequirementId], references: [id])

  @@unique([tenantId, regulatoryRequirementId])
  @@index([tenantId])
}

enum ServiceRequestType {
  FULL_SETUP
  RISK_ASSESSMENT
  ROUTINE_SETUP
  HANDBOOK_SETUP
  REGULATORY_PROFILE
  CUSTOM
}

enum ServiceRequestStatus {
  PENDING
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
