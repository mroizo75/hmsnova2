model TimeEntry {
  id              String        @id @default(cuid())
  tenantId        String
  projectId       String
  userId          String // Ansatt som registrerte
  date            DateTime      @db.Date
  hours           Float
  timeType        TimeEntryType @default(NORMAL)
  workedUntilHour Int? // Arbeidet til kl (0–23). For kveldsovertid 100 %
  comment         String?       @db.Text
  editedById      String? // Hvis admin har rettet
  editedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  editedBy User?   @relation("TimeEntryEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([projectId])
  @@index([userId])
  @@index([date])
}

enum TimeEntryType {
  NORMAL // Ordinær tid
  OVERTIME_50 // Overtid 50 %
  OVERTIME_40 // Overtid 40 % (kundespesifikk)
  OVERTIME_100 // Overtid 100 %
  WEEKEND // Helg/helligdag
  TRAVEL // Reise/kjøring (timer, ikke km)
  SICK_LEAVE // Sykefravær (Sick Day / Sick Leave)
