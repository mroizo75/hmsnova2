}

// ============================================
// Komplett pakke – venteliste og tilbudsforespørsler
// ============================================

model PackageLead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  phone     String?
  tier      String // SMALL = 1-5, MEDIUM = 5-20, LARGE = 20+
  type      String // WAITLIST | CONTACT (tilbud/ring meg)
  source    String   @default("komplett-pakke")
  createdAt DateTime @default(now())
